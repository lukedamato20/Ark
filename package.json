{
  "name": "ark",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.33.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 1420",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "brand:icons": "tauri icon src/assets/brand/ark-mark.svg",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "architecture:check": "node scripts/check-module-boundaries.mjs",
    "design-tokens:check": "node scripts/check-design-tokens.mjs",
    "support:check": "node scripts/check-support-matrix.mjs",
    "baseline:check": "node scripts/reference-dataset.mjs --check",
    "baseline:fixtures": "node scripts/reference-dataset.mjs",
    "baseline:manifest": "node scripts/reference-dataset.mjs --print-manifest",
    "contract:check": "node scripts/check-contract.mjs",
    "test:state": "node --experimental-strip-types --test src/state/*.test.ts",
    "test:frontend:unit": "node --experimental-strip-types --test src/state/*.test.ts src/lib/*.test.ts",
    "test:frontend:components": "vitest run",
    "test:frontend": "pnpm test:frontend:unit && pnpm test:frontend:components",
    "test:e2e": "playwright test",
    "test:supply-chain": "node --test scripts/runtime-supply-chain.test.mjs scripts/brand-assets.test.mjs",
    "secret-boundary:check": "node scripts/check-secret-boundaries.mjs",
    "csp:check": "node scripts/check-csp.mjs",
    "markdown-safety:check": "node scripts/check-markdown-safety.mjs",
    "supply-chain:generate": "node scripts/generate-supply-chain-artifacts.mjs",
    "supply-chain:check": "node --test scripts/runtime-supply-chain.test.mjs scripts/brand-assets.test.mjs && node scripts/generate-supply-chain-artifacts.mjs --check",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"*.{js,json}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" \"*.{js,json}\""
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@tanstack/react-virtual": "^3.14.9",
    "@tauri-apps/api": "^2.0.0",
    "@tauri-apps/plugin-notification": "^2.0.0",
    "@tauri-apps/plugin-opener": "^2.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.0.0",
    "highlight.js": "^11.11.1",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^9.0.1",
    "remark-gfm": "^4.0.0",
    "tailwind-merge": "^2.5.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.62.1",
    "@tauri-apps/cli": "^2.0.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.4",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.26",
    "globals": "^15.15.0",
    "jsdom": "^30.0.1",
    "postcss": "^8.5.23",
    "prettier": "^3.9.6",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.67.0",
    "vite": "^6.0.0",
    "vitest": "^4.1.10",
    "vitest-axe": "^0.1.0"
  }
}
