{
  "openapi": "3.1.0",
  "info": {
    "title": "Ark Companion API",
    "version": "1.0.0",
    "description": "Authenticated, loopback-only Ark integration API. The API is disabled by default. Every route, including health and this document, requires the bearer token generated in Ark Settings."
  },
  "servers": [
    {
      "url": "http://127.0.0.1:{port}",
      "description": "The loopback endpoint shown in Ark Settings while the API is running.",
      "variables": {
        "port": {
          "default": "49152",
          "description": "The OS-assigned port shown by Ark."
        }
      }
    }
  ],
  "security": [{ "bearerAuth": [] }],
  "paths": {
    "/v1/openapi.json": {
      "get": {
        "operationId": "getOpenApiDocument",
        "summary": "Get this API contract",
        "parameters": [{ "$ref": "#/components/parameters/RequestedApiVersion" }],
        "responses": {
          "200": {
            "description": "The OpenAPI 3.1 document.",
            "headers": {
              "X-Request-Id": { "$ref": "#/components/headers/RequestId" },
              "X-Ark-Api-Version": { "$ref": "#/components/headers/ApiVersion" }
            },
            "content": {
              "application/json": {
                "schema": { "type": "object" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/InvalidRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "429": { "$ref": "#/components/responses/RateLimited" }
        }
      }
    },
    "/v1/conversations/{conversationId}": {
      "patch": {
        "operationId": "updateConversation",
        "summary": "Rename and/or archive a conversation exactly once",
        "parameters": [
          { "$ref": "#/components/parameters/RequestedApiVersion" },
          { "$ref": "#/components/parameters/IdempotencyKey" },
          {
            "name": "conversationId",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/UpdateConversationRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The updated conversation, or the original result of a matching retry.",
            "headers": {
              "X-Request-Id": { "$ref": "#/components/headers/RequestId" },
              "X-Ark-Api-Version": { "$ref": "#/components/headers/ApiVersion" }
            },
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Conversation" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/InvalidRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "409": { "$ref": "#/components/responses/IdempotencyConflict" },
          "413": { "$ref": "#/components/responses/PayloadTooLarge" },
          "429": { "$ref": "#/components/responses/RateLimited" },
          "503": { "$ref": "#/components/responses/Unavailable" }
        }
      }
    },
    "/v1/health": {
      "get": {
        "operationId": "getHealth",
        "summary": "Check whether the authenticated API is ready",
        "parameters": [{ "$ref": "#/components/parameters/RequestedApiVersion" }],
        "responses": {
          "200": {
            "description": "Ark's local API is ready.",
            "headers": {
              "X-Request-Id": { "$ref": "#/components/headers/RequestId" },
              "X-Ark-Api-Version": { "$ref": "#/components/headers/ApiVersion" }
            },
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Health" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/InvalidRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "413": { "$ref": "#/components/responses/PayloadTooLarge" },
          "429": { "$ref": "#/components/responses/RateLimited" }
        }
      }
    },
    "/v1/providers": {
      "get": {
        "operationId": "listProviders",
        "summary": "List configured providers without endpoints or secret references",
        "parameters": [{ "$ref": "#/components/parameters/RequestedApiVersion" }],
        "responses": {
          "200": {
            "description": "Provider selection and capability summaries.",
            "headers": {
              "X-Request-Id": { "$ref": "#/components/headers/RequestId" },
              "X-Ark-Api-Version": { "$ref": "#/components/headers/ApiVersion" }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": { "$ref": "#/components/schemas/ProviderSummary" }
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/InvalidRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "413": { "$ref": "#/components/responses/PayloadTooLarge" },
          "429": { "$ref": "#/components/responses/RateLimited" },
          "503": { "$ref": "#/components/responses/Unavailable" }
        }
      }
    },
    "/v1/providers/{providerId}/models": {
      "get": {
        "operationId": "listProviderModels",
        "summary": "List Ark's cached model inventory for a provider",
        "parameters": [
          { "$ref": "#/components/parameters/RequestedApiVersion" },
          {
            "name": "providerId",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "Cached model selection and capability summaries. This route performs no provider network request.",
            "headers": {
              "X-Request-Id": { "$ref": "#/components/headers/RequestId" },
              "X-Ark-Api-Version": { "$ref": "#/components/headers/ApiVersion" }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": { "$ref": "#/components/schemas/ModelSummary" }
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/InvalidRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "413": { "$ref": "#/components/responses/PayloadTooLarge" },
          "429": { "$ref": "#/components/responses/RateLimited" },
          "503": { "$ref": "#/components/responses/Unavailable" }
        }
      }
    },
    "/v1/conversations": {
      "get": {
        "operationId": "listConversations",
        "summary": "List conversations using stable cursor pagination",
        "parameters": [
          { "$ref": "#/components/parameters/RequestedApiVersion" },
          {
            "name": "limit",
            "in": "query",
            "schema": { "type": "integer", "minimum": 1, "maximum": 100, "default": 50 }
          },
          {
            "name": "cursor",
            "in": "query",
            "schema": { "type": "string" }
          },
          {
            "name": "query",
            "in": "query",
            "schema": { "type": "string" }
          },
          {
            "name": "archived",
            "in": "query",
            "schema": { "type": "boolean" }
          },
          {
            "name": "projectId",
            "in": "query",
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "A bounded page of conversations.",
            "headers": {
              "X-Request-Id": { "$ref": "#/components/headers/RequestId" },
              "X-Ark-Api-Version": { "$ref": "#/components/headers/ApiVersion" }
            },
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ConversationPage" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/InvalidRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "413": { "$ref": "#/components/responses/PayloadTooLarge" },
          "429": { "$ref": "#/components/responses/RateLimited" },
          "503": { "$ref": "#/components/responses/Unavailable" }
        }
      },
      "post": {
        "operationId": "createConversation",
        "summary": "Create a conversation exactly once",
        "parameters": [
          { "$ref": "#/components/parameters/RequestedApiVersion" },
          { "$ref": "#/components/parameters/IdempotencyKey" }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/CreateConversationRequest" }
            }
          }
        },
        "responses": {
          "201": {
            "description": "The newly created conversation, or the original result of a matching retry.",
            "headers": {
              "X-Request-Id": { "$ref": "#/components/headers/RequestId" },
              "X-Ark-Api-Version": { "$ref": "#/components/headers/ApiVersion" }
            },
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Conversation" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/InvalidRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "409": { "$ref": "#/components/responses/IdempotencyConflict" },
          "413": { "$ref": "#/components/responses/PayloadTooLarge" },
          "429": { "$ref": "#/components/responses/RateLimited" },
          "503": { "$ref": "#/components/responses/Unavailable" }
        }
      }
    },
    "/v1/conversations/{conversationId}/messages": {
      "get": {
        "operationId": "listConversationMessages",
        "summary": "Get the active message path for one conversation",
        "parameters": [
          { "$ref": "#/components/parameters/RequestedApiVersion" },
          {
            "name": "conversationId",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "Messages on the active path, in conversation order.",
            "headers": {
              "X-Request-Id": { "$ref": "#/components/headers/RequestId" },
              "X-Ark-Api-Version": { "$ref": "#/components/headers/ApiVersion" }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": { "$ref": "#/components/schemas/Message" }
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/InvalidRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "413": { "$ref": "#/components/responses/PayloadTooLarge" },
          "429": { "$ref": "#/components/responses/RateLimited" },
          "503": { "$ref": "#/components/responses/Unavailable" }
        }
      },
      "post": {
        "operationId": "sendMessage",
        "summary": "Submit one user turn and start its provider generation exactly once",
        "parameters": [
          { "$ref": "#/components/parameters/RequestedApiVersion" },
          { "$ref": "#/components/parameters/IdempotencyKey" },
          {
            "name": "conversationId",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/SendMessageRequest" }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Durable user/assistant message IDs. Poll the conversation messages route for streaming and terminal state. A matching retry returns these same IDs and never starts a second provider request.",
            "headers": {
              "X-Request-Id": { "$ref": "#/components/headers/RequestId" },
              "X-Ark-Api-Version": { "$ref": "#/components/headers/ApiVersion" }
            },
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/SendChatResult" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/InvalidRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "409": { "$ref": "#/components/responses/IdempotencyConflict" },
          "413": { "$ref": "#/components/responses/PayloadTooLarge" },
          "429": { "$ref": "#/components/responses/RateLimited" },
          "503": { "$ref": "#/components/responses/Unavailable" }
        }
      }
    },
    "/v1/messages/{messageId}/cancel": {
      "post": {
        "operationId": "cancelGeneration",
        "summary": "Durably cancel an active generation exactly once",
        "parameters": [
          { "$ref": "#/components/parameters/RequestedApiVersion" },
          { "$ref": "#/components/parameters/IdempotencyKey" },
          {
            "name": "messageId",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/EmptyMutationRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The durable post-cancellation message, or the original result of a matching retry.",
            "headers": {
              "X-Request-Id": { "$ref": "#/components/headers/RequestId" },
              "X-Ark-Api-Version": { "$ref": "#/components/headers/ApiVersion" }
            },
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Message" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/InvalidRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "409": { "$ref": "#/components/responses/IdempotencyConflict" },
          "413": { "$ref": "#/components/responses/PayloadTooLarge" },
          "429": { "$ref": "#/components/responses/RateLimited" },
          "503": { "$ref": "#/components/responses/Unavailable" }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "The one-time-revealed token generated in Ark Settings."
      }
    },
    "headers": {
      "RequestId": {
        "description": "Caller-supplied or Ark-generated request correlation ID.",
        "schema": { "type": "string", "maxLength": 128, "pattern": "^[A-Za-z0-9_.:-]+$" }
      },
      "ApiVersion": {
        "description": "The selected path API version.",
        "schema": { "type": "string", "const": "v1" }
      }
    },
    "parameters": {
      "RequestedApiVersion": {
        "name": "X-Ark-Api-Version",
        "in": "header",
        "required": false,
        "description": "Optional explicit version negotiation. Omit to select the version in the path; send v1 to require v1. Unknown versions fail with unsupported_api_version.",
        "schema": { "type": "string", "const": "v1" }
      },
      "IdempotencyKey": {
        "name": "Idempotency-Key",
        "in": "header",
        "required": true,
        "description": "Unique mutation key. A matching retry returns the stored original response; reuse with another method, path, body, or expected status returns 409.",
        "schema": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_.:-]+$"
        }
      }
    },
    "responses": {
      "InvalidRequest": {
        "description": "The request is invalid.",
        "content": {
          "application/json": { "schema": { "$ref": "#/components/schemas/ErrorEnvelope" } }
        }
      },
      "Unauthorized": {
        "description": "The bearer token is missing or invalid.",
        "content": {
          "application/json": { "schema": { "$ref": "#/components/schemas/ErrorEnvelope" } }
        }
      },
      "NotFound": {
        "description": "The requested entity or route does not exist.",
        "content": {
          "application/json": { "schema": { "$ref": "#/components/schemas/ErrorEnvelope" } }
        }
      },
      "IdempotencyConflict": {
        "description": "The idempotency key was already used for a different mutation.",
        "content": {
          "application/json": { "schema": { "$ref": "#/components/schemas/ErrorEnvelope" } }
        }
      },
      "PayloadTooLarge": {
        "description": "The request body exceeds Ark's 64 KiB limit.",
        "content": {
          "application/json": { "schema": { "$ref": "#/components/schemas/ErrorEnvelope" } }
        }
      },
      "RateLimited": {
        "description": "The loopback token exceeded 120 requests in 60 seconds.",
        "content": {
          "application/json": { "schema": { "$ref": "#/components/schemas/ErrorEnvelope" } }
        }
      },
      "Unavailable": {
        "description": "Ark is starting or the workspace is temporarily unavailable.",
        "content": {
          "application/json": { "schema": { "$ref": "#/components/schemas/ErrorEnvelope" } }
        }
      }
    },
    "schemas": {
      "Health": {
        "type": "object",
        "additionalProperties": false,
        "required": ["status", "version"],
        "properties": {
          "status": { "type": "string", "const": "ok" },
          "version": { "type": "string", "const": "v1" }
        }
      },
      "ErrorEnvelope": {
        "type": "object",
        "additionalProperties": false,
        "required": ["error"],
        "properties": {
          "error": {
            "type": "object",
            "additionalProperties": false,
            "required": ["code", "message"],
            "properties": {
              "code": { "type": "string" },
              "message": { "type": "string" }
            }
          }
        }
      },
      "ConversationPage": {
        "type": "object",
        "additionalProperties": false,
        "required": ["items", "nextCursor", "searchSnippets"],
        "properties": {
          "items": { "type": "array", "items": { "$ref": "#/components/schemas/Conversation" } },
          "nextCursor": { "type": ["string", "null"] },
          "searchSnippets": { "type": "object", "additionalProperties": { "type": "string" } }
        }
      },
      "CreateConversationRequest": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "title": { "type": ["string", "null"] }
        }
      },
      "UpdateConversationRequest": {
        "type": "object",
        "additionalProperties": false,
        "minProperties": 1,
        "anyOf": [{ "required": ["title"] }, { "required": ["archived"] }],
        "properties": {
          "title": { "type": "string" },
          "archived": { "type": "boolean" }
        }
      },
      "SendMessageRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": ["content", "providerId", "model"],
        "properties": {
          "content": { "type": "string", "minLength": 1 },
          "providerId": { "type": "string", "minLength": 1, "maxLength": 128 },
          "model": { "type": "string", "minLength": 1, "maxLength": 128 },
          "temperature": { "type": ["number", "null"], "minimum": 0, "maximum": 2 },
          "maxTokens": { "type": ["integer", "null"], "minimum": 1, "maximum": 1000000 },
          "attachmentIds": {
            "type": "array",
            "items": { "type": "string", "minLength": 1, "maxLength": 128 }
          }
        }
      },
      "EmptyMutationRequest": {
        "type": "object",
        "additionalProperties": false,
        "maxProperties": 0
      },
      "SendChatResult": {
        "type": "object",
        "additionalProperties": false,
        "required": ["conversationId", "userMessageId", "assistantMessageId"],
        "properties": {
          "conversationId": { "type": "string" },
          "userMessageId": { "type": "string" },
          "assistantMessageId": { "type": "string" }
        }
      },
      "ProviderCapabilities": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "streaming", "modelListing", "modelPull", "modelDelete", "modelUnload",
          "requiresAuth", "reportsContextWindow", "vision", "embeddings", "tools"
        ],
        "properties": {
          "streaming": { "type": "boolean" },
          "modelListing": { "type": "boolean" },
          "modelPull": { "type": "boolean" },
          "modelDelete": { "type": "boolean" },
          "modelUnload": { "type": "boolean" },
          "requiresAuth": { "type": "boolean" },
          "reportsContextWindow": { "type": "boolean" },
          "vision": { "type": "boolean" },
          "embeddings": { "type": "boolean" },
          "tools": { "type": "boolean" }
        }
      },
      "ProviderSummary": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id", "name", "providerType", "defaultModelId", "defaultTemperature",
          "defaultMaxTokens", "isLocal", "destinationClass", "capabilities", "isEnabled",
          "credentialConfigured"
        ],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "providerType": { "type": "string" },
          "defaultModelId": { "type": ["string", "null"] },
          "defaultTemperature": { "type": ["number", "null"] },
          "defaultMaxTokens": { "type": ["integer", "null"] },
          "isLocal": { "type": "boolean" },
          "destinationClass": { "type": "string", "enum": ["loopback", "private_lan", "public"] },
          "capabilities": { "$ref": "#/components/schemas/ProviderCapabilities" },
          "isEnabled": { "type": "boolean" },
          "credentialConfigured": { "type": "boolean" }
        }
      },
      "ModelSummary": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id", "providerId", "name", "displayName", "contextWindow", "supportsStreaming",
          "supportsTools", "toolCallingMode", "supportsVision", "supportsEmbeddings", "isAvailable", "lastSeenAt"
        ],
        "properties": {
          "id": { "type": "string" },
          "providerId": { "type": "string" },
          "name": { "type": "string" },
          "displayName": { "type": ["string", "null"] },
          "contextWindow": { "type": ["integer", "null"] },
          "supportsStreaming": { "type": "boolean" },
          "supportsTools": { "type": "boolean" },
          "toolCallingMode": { "type": "string", "enum": ["native", "prompted", "unsupported"] },
          "supportsVision": { "type": "boolean" },
          "supportsEmbeddings": { "type": "boolean" },
          "isAvailable": { "type": "boolean" },
          "lastSeenAt": { "type": ["string", "null"] }
        }
      },
      "Conversation": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id", "title", "createdAt", "updatedAt", "providerId", "modelId", "currentMessageId",
          "systemPrompt", "temperature", "maxTokens", "archived", "projectId", "pinnedAt",
          "personaId", "responseStyle", "tone"
        ],
        "properties": {
          "id": { "type": "string" },
          "title": { "type": "string" },
          "createdAt": { "type": "string" },
          "updatedAt": { "type": "string" },
          "providerId": { "type": ["string", "null"] },
          "modelId": { "type": ["string", "null"] },
          "currentMessageId": { "type": ["string", "null"] },
          "systemPrompt": { "type": ["string", "null"] },
          "temperature": { "type": ["number", "null"] },
          "maxTokens": { "type": ["integer", "null"] },
          "archived": { "type": "boolean" },
          "projectId": { "type": ["string", "null"] },
          "pinnedAt": { "type": ["string", "null"] },
          "personaId": { "type": ["string", "null"] },
          "responseStyle": { "type": ["string", "null"] },
          "tone": { "type": ["string", "null"] }
        }
      },
      "Message": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id", "conversationId", "parentMessageId", "revisionOfMessageId", "pathIndex", "role",
          "content", "status", "createdAt", "updatedAt", "providerId", "modelId", "tokenCount",
          "errorMessage", "metadataJson", "branchName"
        ],
        "properties": {
          "id": { "type": "string" },
          "conversationId": { "type": "string" },
          "parentMessageId": { "type": ["string", "null"] },
          "revisionOfMessageId": { "type": ["string", "null"] },
          "pathIndex": { "type": "integer" },
          "role": { "type": "string" },
          "content": { "type": "string" },
          "status": { "type": "string" },
          "createdAt": { "type": "string" },
          "updatedAt": { "type": "string" },
          "providerId": { "type": ["string", "null"] },
          "modelId": { "type": ["string", "null"] },
          "tokenCount": { "type": ["integer", "null"] },
          "errorMessage": { "type": ["string", "null"] },
          "metadataJson": { "type": ["string", "null"] },
          "branchName": { "type": ["string", "null"] }
        }
      }
    }
  }
}
