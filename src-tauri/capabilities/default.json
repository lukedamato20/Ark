{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default permissions for Ark",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:event:default",
    "opener:allow-open-url",
    "opener:allow-default-urls",
